# Copier vers .env et adapter
VINTED_BASE_URL=https://www.vinted.fr
# Chemin vers la session Playwright (créée via npm run login)
AUTH_STATE_PATH=data/auth-state.json
# URL complète de l'annonce cible
ITEM_URL=
# Sécurité : doit être "true" pour cliquer sur Acheter
ENABLE_PURCHASE=false
# Prix maximum (€) — refus si le prix affiché dépasse cette valeur
MAX_PRICE_EUR=
# Téléphone checkout (format libre, ex. +32 470 84 87 23) — ne pas committer .env
VINTED_PHONE=
